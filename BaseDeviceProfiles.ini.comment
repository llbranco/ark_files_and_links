; PVP profile uses these values where farm differs (see alternates above).
; FrameRateCap=240, FrameRateMinimum=144, MinDesiredFrameRate=70
; MinSmoothedFrameRate=5, MaxSmoothedFrameRate=144
; ShowFlag.Fog=1  (farm keeps Fog commented/0)
; ShowFlag.Materials=0  (farm keeps Materials commented)
; WARNING: .pvp line 125 has broken '+CVars=ShowFlag' — delete or fix manually.

; =============================================================================
; PVP WINDOWS CVars not duplicated above (general stuff overlap omitted)
; =============================================================================
; --- MaxSmoothedFrameRate = 144 ---
; PT: Limite superior smooth FR.
; EN: Upper smoothed FR.
; ARK: bSmoothFrameRate.
; ON/OFF: 144 [PVP].
; FX: 
; PVP-ONLY: pvp=144
;+CVars=MaxSmoothedFrameRate=144  ; PVP value — uncomment if you want PVP override

; --- MinSmoothedFrameRate = 5 ---
; PT: Limite inferior smooth FR.
; EN: Lower smoothed FR.
; ARK: bSmoothFrameRate.
; ON/OFF: 5 [PVP only].
; FX: Comente se não usar smooth.
; PVP-ONLY: pvp=5
;+CVars=MinSmoothedFrameRate=5  ; PVP value — uncomment if you want PVP override

; --- ShowFlag.Fog = 1 ---
; PT: Pass fog engine.
; EN: Fog pass.
; ARK: Névoa extra.
; ON/OFF: FARM comentado/0; PVP=1 ATIVO.
; FX: Escolha um valor.
; PVP-ONLY: pvp=1
;+CVars=ShowFlag.Fog=1  ; PVP value — uncomment if you want PVP override

; --- ShowFlag.Materials = 0 ---
; PT: Materiais/custom depth Tek.
; EN: Materials / Tek vision.
; ARK: Owl, railgun, helmet.
; ON/OFF: PVP=0 ativo; farm comentado.
; FX: 0 remove beer blur fix.
; PVP-ONLY: pvp=0
;+CVars=ShowFlag.Materials=0  ; PVP value — uncomment if you want PVP override


; =============================================================================
; EXTRA COMMUNITY CVars (optional)
; Fontes: Pastebin Soft INI, cornernote gist, llbranco farm comments
; =============================================================================
;
; --- ShowFlag.Splines=2 (gist: beams normal) / feixe drop e transmitter ---
; PT: Valor 2 = visibilidade normal de splines em alguns guias. EN: Value 2 = normal beam visibility.
;+CVars=ShowFlag.Splines=2
;
; --- ShowFlag.GameplayDebug=2 (gist: water + overlays normal) ---
;+CVars=ShowFlag.GameplayDebug=2
;
; --- FX particles competitive ---
;+CVars=FX.MaxCPUParticlesPerEmitter=8
;+CVars=FX.MaxCPUParticlesPerEmitter=16
;+CVars=FX.MaxGPUParticlesPerEmitter=64
;
; --- Foliage aggressive (gist) ---
;+CVars=foliage.CullAll=1
;
; --- Atmosphere / volumetric (ConsoleVariables.ini comum) ---
;+CVars=r.Atmosphere=0
;+CVars=r.VolumetricFog=0
;+CVars=r.VolumetricCloud=0
;+CVars=r.LightShafts=0
;
; --- Particle / mesh LOD ---
;+CVars=r.ParticleLODBias=2
;+CVars=r.SkeletalMeshLODBias=2
;+CVars=r.TerrainLODScale=0.5
;
; --- Distância PvP normal ---
;+CVars=r.ViewDistanceScale=1.0
;
; =============================================================================
; ALTERNATES — uncomment ONE per group / descomente UMA por grupo
; =============================================================================
