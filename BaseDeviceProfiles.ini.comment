; =============================================================================
; BaseDeviceProfiles.ini.comment — MERGE COMPLETO (.farm + .pvp) + EXTRAS COMUNIDADE
; PT: União documentada. Comentários com ; não afetam o jogo. +CVars = ativo.
; EN: Full documented merge. Semicolon comments are ignored by the game. +CVars = active.
; Path: ARK/Engine/Config/BaseDeviceProfiles.ini
; Toggle: add ; before +CVars to disable that line.
; =============================================================================
;
; Edited by:
; ██╗     ██╗     ██████╗ ██████╗  █████╗ ███╗   ██╗ ██████╗ ██████╗
; ██║     ██║     ██╔══██╗██╔══██╗██╔══██╗████╗  ██║██╔════╝██╔═══██╗
; ██║     ██║     ██████╔╝██████╔╝███████║██╔██╗ ██║██║     ██║   ██║
; ██║     ██║     ██╔══██╗██╔══██╗██╔══██║██║╚██╗██║██║     ██║   ██║
; ███████╗███████╗██████╔╝██║  ██║██║  ██║██║ ╚████║╚██████╗╚██████╔╝
; ╚══════╝╚══════╝╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚═════╝
;
; MERGE: BaseDeviceProfiles.ini.farm + BaseDeviceProfiles.ini.pvp + Pastebin/gist community
; DOC: 2026-05-19
;
[DeviceProfiles]
+DeviceProfileNameAndTypes=Windows,Windows
+DeviceProfileNameAndTypes=WindowsNoEditor,WindowsNoEditor

; =============================================================================
; GAMEPLAY VISUALS — QUICK REFERENCE / EFEITOS DE GAMEPLAY
; =============================================================================
; | Effect / Efeito                    | Visible (descomente/ON)          | OFF (=0) farm/PvP |
; |------------------------------------|----------------------------------|-------------------|
; | Beer / Plant Species Z blur        | NÃO use Materials=0 no general   | Particles=0       |
; | Snow Owl / Tek helmet / Bloodstalk | Materials=0 + r.CustomDepth=0    | (comentado farm)  |
; | Supply drop vertical beam          | Splines=1 ou 2                   | Splines=0         |
; | Tek Transmitter sky beam           | Splines=1, PointLights=1         | Splines=0         |
; | Flamethrower / fire / smoke        | Particles=1, FX particles 8-16   | Particles=0, FX=1 |
; | Gun tracers / impact decals        | Particles=1, Decals=1            | Decals=0          |
; | Poison wyvern / basilisk cloud     | FX.MaxCPUParticles 8-16          | FX=1              |
; | Parasaur red enemy ping            | GameplayDebug=1 ou 2             | GameplayDebug=0   |
; | Structure placement overlay        | GameplayDebug=1 ou 2             | GameplayDebug=0   |
; | Water surface / mana beam          | GameplayDebug=2 (gist)           | GameplayDebug=0   |
; =============================================================================


[Windows DeviceProfile]
DeviceType=Windows
BaseProfileName=
 
; [EN] Soft potato block — distant meshes/atmosphere/bloom reduced.
; [PT] Bloco soft potato — reduz malhas distantes, atmosfera e bloom.
; soft ini for performance
; --- ShowFlag.StaticMeshes = 0 ---
; PT: Malhas estáticas.
; EN: Static meshes.
; ARK: Mundo/props.
; ON/OFF: 0 soft+general.
; FX: 
+CVars=ShowFlag.StaticMeshes=0
; --- ShowFlag.VisualizeLPV = 0 ---
; PT: Variável gráfica Unreal/ARK (ShowFlag ou r.*).
; EN: Unreal/ARK graphics variable (ShowFlag or r.*).
; ARK: 0 usually disables/hides pass; 1 enables. Test in single-player.
; ON/OFF: Toggle by commenting the +CVars line below.
; FX: Part of farm 'general stuff' potato preset when =0.
+CVars=ShowFlag.VisualizeLPV=0
; --- FogDensity = 0.0 ---
; PT: Densidade névoa.
; EN: Fog density.
; ARK: Visibilidade.
; ON/OFF: 0.0 ambos.
; FX: 
+CVars=FogDensity=0.0
; --- ShowFlag.Atmosphere = 0 ---
; PT: Atmosfera/céu.
; EN: Atmosphere.
; ARK: Haze.
; ON/OFF: 0 potato.
; FX: Duplicado no farm.
+CVars=ShowFlag.Atmosphere=0
; --- ShowFlag.AtmosphericFog = 0 ---
; PT: Névoa atmosférica.
; EN: Atmospheric fog.
; ARK: Neblina mapa.
; ON/OFF: 0.
; FX: 
+CVars=ShowFlag.AtmosphericFog=0
; --- r.BloomQuality = 0 ---
; PT: Bloom.
; EN: Bloom.
; ARK: Brilho.
; ON/OFF: 0 múltiplas vezes farm.
; FX: 
+CVars=r.BloomQuality=0

; [EN] Structure debug for building.
; [PT] Debug de estruturas para construir.
; show linked structures, just a try
; --- DebugStructures = 1 ---
; PT: Debug estruturas linkadas.
; EN: Linked structure debug.
; ARK: Snaps build.
; ON/OFF: 1 farm.
; FX: 
+CVars=DebugStructures=1
; --- t.DebugStructures = 1 ---
; PT: Debug estruturas (t.).
; EN: Linked structure debug (t.).
; ARK: 
; ON/OFF: 1.
; FX: 
+CVars=t.DebugStructures=1
; --- r.DebugStructures = 1 ---
; PT: Debug estruturas (r.).
; EN: Linked structure debug (r.).
; ARK: 
; ON/OFF: 1.
; FX: 
+CVars=r.DebugStructures=1

; [EN] FPS caps and thread lag.
; [PT] Caps de FPS e lag de thread.
; framerate
; --- t.maxfps = 144 ---
; PT: Teto FPS Unreal.
; EN: Unreal max FPS.
; ARK: Cap de quadros.
; ON/OFF: 144 farm / 144 pvp.
; FX: Alinhe FrameRateCap.
+CVars=t.maxfps=144
; --- FrameRateCap = 144 ---
; PT: Cap FPS do ARK.
; EN: ARK FPS cap.
; ARK: Limite render.
; ON/OFF: 144 farm, 240 pvp.
; FX: Acima do Hz do monitor: tearing.
; MERGE: farm=144 | pvp=240 — active line uses FARM value; see ALTERNATES for PVP.
+CVars=FrameRateCap=144
; --- MinDesiredFrameRate = 75 ---
; PT: FPS desejado mínimo.
; EN: Min desired FPS.
; ARK: Smooth FR.
; ON/OFF: 75 farm, 70 pvp.
; FX: 
; MERGE: farm=75 | pvp=70 — active line uses FARM value; see ALTERNATES for PVP.
+CVars=MinDesiredFrameRate=75
; --- FrameRateMinimum = 75 ---
; PT: FPS mínimo.
; EN: Minimum FPS.
; ARK: Piso.
; ON/OFF: 75 farm, 144 pvp.
; FX: 
; MERGE: farm=75 | pvp=144 — active line uses FARM value; see ALTERNATES for PVP.
+CVars=FrameRateMinimum=75
; --- r.oneframethreadlag = 1 ---
; PT: 1 frame lag render thread.
; EN: 1-frame render lag.
; ARK: FPS vs input.
; ON/OFF: 1=ON mais FPS.
; FX: 0=input mais seco.
+CVars=r.oneframethreadlag=1 

; General improvements, never remove this section
; --- bFirstRun = False ---
; PT: Primeira execução.
; EN: First run flag.
; ARK: Setup.
; ON/OFF: False.
; FX: 
+CVars=bFirstRun=False
; --- bSmoothFrameRate = true ---
; PT: Suavização de FPS.
; EN: Frame smoothing.
; ARK: Frame pacing.
; ON/OFF: true.
